# Telegram Bot Token (from @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz123456789

# MongoDB Atlas connection string (use NEW rotated password, DB name in path)
MONGO_URI=mongodb+srv://username:password@cluster0.drjaxl8.mongodb.net/telegram_bot?retryWrites=true&w=majority
DB_NAME=telegram_bot

# Comma-separated Telegram user IDs who get admin access
ADMIN_USER_IDS=123456789

# Your bot's username, without @ (used for referral links)
BOT_USERNAME=YourBotUsername

# Support bot/account username, without @
SUPPORT_USERNAME=YourSupportUsername

# Referral earning percentage
REFERRAL_PERCENT=3.0

# Force-join channel username, without @
CHANNEL_USERNAME=YourChannelUsername

# Channel where sold-account reports get posted (bot must be admin), without @
REPORT_CHANNEL_USERNAME=YourReportChannel

# Telegram API credentials (from my.telegram.org) — used for admin login/add-account flow
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890

# Paytm auto-verification API (third-party payment checker)
PAYTM_API_URL=https://tusharbairagi.online
PAYTM_API_KEY=your_paytm_api_key
PAYTM_MID=your_paytm_mid
PAYTM_UPI_ID=your_upi_id@bank
